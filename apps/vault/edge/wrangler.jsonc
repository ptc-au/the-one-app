{
  "name": "network-vault",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Its one page, plain HTML (`page/`, copied by its build), which the Worker hands out itself:
  // every request comes to it first.
  "assets": { "directory": "files", "binding": "ASSETS", "run_worker_first": true }
}
