#!/usr/bin/env bash
# Makes a network's installers, its app as a person installs it the first time on each kind of computer and phone, from
# the core's latest builds, and publishes them in the network's Software Update (`publish_installer`), which the
# network's download page, <address>/download, offers (the Downloads app): for the network of this machine's `one`, or
# the one in ONE_HOME, from the network's repo, which says its name, icon and address:
#
#     tooling/installers <the network's repo>
#
# An installer whose build is the one published already is left as it is. `tooling/release client` runs it once it has
# published, from ONE_NETWORK_REPO. From then on the app updates itself.
set -euo pipefail
[[ -d ${1:-} ]] || { echo "tooling/installers <the network's repo>" >&2 && exit 1; }
network=$(cd "$1" && pwd)
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d) && trap 'rm -rf "$work"' EXIT

git -C "$network" fetch -q origin main
config=$(git -C "$network" show origin/main:app/tauri.conf.json)
name=$(jq -r '.productName // "The One App"' <<<"$config")
published=$(one software-update installers)
# The core's latest build of `$2` for a kind of machine `$1`, as every network's devices take it (`core/edge/updater/core.ts`).
latest() { curl -fsSL "https://github.com/ptc-au/the-one-app/releases/download/builds/$1.json" | jq -e ".[\"$2\"]"; }
# It downloaded, checked against its SHA-256 and unpacked, in `$2`.
fetched() {
  curl -fsSL -o "$2.gz" "$(jq -r .link.url <<<"$1")"
  sha256sum -c --quiet <<<"$(jq -r .sha256 <<<"$1")  $2.gz"
  gunzip -c "$2.gz" >"$2"
}
has() { jq -e --arg platform "$1" --arg build "$2" 'any(.installers[]; .platform == $platform and .build == $build)' <<<"$published" >/dev/null; }

# A Mac with Apple silicon: the app in a disk image, notarised (`tooling/mac-dmg`).
build=$(latest macos-aarch64 one | jq -r .build)
if has mac "$build"; then
  echo "mac: $name.dmg is $build already"
else
  build=$("$root/tooling/mac-dmg" "$network" "$work/$name.dmg" | tail -1)
  one software-update publish_installer --platform mac --name "$name.dmg" --build "$build" --file-from "$work/$name.dmg" >/dev/null
  echo "mac: published $name.dmg, $build"
fi

# Windows: the One App's installer (`clients/app/installer.nsi`), with the network's address beside the app, signed
# with its uninstaller (`tooling/windows-sign`).
one=$(latest windows-x86_64 one) build=$(jq -r .build <<<"$one")
if has windows "$build"; then
  echo "windows: $name Setup.exe is $build already"
else
  fetched "$one" "$work/one.exe"
  git -C "$network" show origin/main:app/address | jq -Rc '{address: .}' >"$work/network"
  makensis -V2 -DVERSION="${build%%+*}" -DPROGRAM="$work/one.exe" -DNETWORK="$work/network" -DOUTFILE="$work/$name Setup.exe" -DSIGN="$root/tooling/windows-sign" \
    -DCOPYRIGHT="$(grep -m1 '^Copyright' "$root/LICENSE")" "$root/clients/app/installer.nsi"
  one software-update publish_installer --platform windows --name "$name Setup.exe" --build "$build" --file-from "$work/$name Setup.exe" >/dev/null
  echo "windows: published $name Setup.exe, $build"
fi
