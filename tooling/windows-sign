#!/usr/bin/env bash
# Signs Windows programs with Authenticode, as Power to Change, with jsign, timestamped by Microsoft's RFC 3161 server,
# so Windows' SmartScreen knows who they're from and doesn't warn before they run:
#
#     tooling/windows-sign <program.exe>...
#
# The certificate is Microsoft's Artifact Signing's, which keeps its key and makes a certificate that lasts three
# days, so the timestamp is what keeps a signature good after. It signs in as the "Artifact Signing" item in the
# `ptc-nosudo` 1Password vault, where the platform's other build secrets are: the Entra app (tenant_id, client_id,
# client_secret) with the Artifact Signing Certificate Profile Signer role, and the account's endpoint, account and
# certificate profile. The app's secret is swapped for a token that lasts an hour, sent to jsign in its environment.
# WINDOWS_SIGNING, jsign's own options naming a keystore of one's own (`--keystore <file>.pfx --storepass <password>`),
# signs with that instead.
#
# Without either, it says in a line that it signed nothing, and the programs ship unsigned.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
if [[ -n ${WINDOWS_SIGNING:-} ]]; then
  read -ra options <<<"$WINDOWS_SIGNING"
else
  fields=$(op item get "Artifact Signing" --vault ptc-nosudo --format json | jq -c '[.fields[] | select(.value) | {(.label): .value}] | add')
  jq -e '.client_secret' >/dev/null <<<"$fields" || { echo "Windows programs aren't signed: the \"Artifact Signing\" item in 1Password has no client_secret yet." && exit 0; }
  token=$(jq -rj '"grant_type=client_credentials&client_id=\(.client_id | @uri)&client_secret=\(.client_secret | @uri)&scope=https%3A%2F%2Fcodesigning.azure.net%2F.default"' <<<"$fields" |
    curl -fsS "https://login.microsoftonline.com/$(jq -r .tenant_id <<<"$fields")/oauth2/v2.0/token" --data-binary @- | jq -r '.access_token // empty')
  [[ -n $token ]] || { echo "Microsoft didn't give a token for the \"Artifact Signing\" item." >&2 && exit 1; }
  # jsign reads the token from the environment, so no other process sees it in its arguments.
  export WINDOWS_SIGNING_TOKEN=$token
  options=(--storetype TRUSTEDSIGNING --storepass env:WINDOWS_SIGNING_TOKEN
    --keystore "$(jq -r '.endpoint | sub("^https://"; "") | rtrimstr("/")' <<<"$fields")"
    --alias "$(jq -r '"\(.account)/\(.profile)"' <<<"$fields")")
fi
jsign=$(mise -C "$root" which jsign.jar)
exec java -jar "$jsign" "${options[@]}" --tsaurl http://timestamp.acs.microsoft.com --tsmode RFC3161 --quiet "$@"
