#!/usr/bin/env bash
# Starts a whole network on this machine, to build or test with, and says how to use it:
#
#     tooling/network <folder> [--standby] [--owner <name>] [--live-edge]
#
# It needs what `mise install` and `rustup` install, and on Linux WebKitGTK (`libwebkit2gtk-4.1-dev`), which the
# app's window is built on.
#
# It builds what isn't built, then starts the network's server in the folder, which is where everything the network
# keeps goes but its bucket: each server's home, its edge's, a client's home and the logs. A new network has every app of this
# repo deployed for it, and installs the ones a network starts with (`OneCore.Apps.Lifecycle.make_first_owner/1`); after that,
# deploy an app you change into it. Starting again in the same folder carries on with what's there, on the same
# ports. Its PID is in the folder's `pid`, and `kill $(cat <folder>/pid)` (or Ctrl-C) stops all of it. Each server's
# is in `<folder>/<server>.pid`.
#
# It's a network being built, so a client says which user it acts as: ONE_AS=<name> before a command acts as that
# user, and ONE_SUBJECT=groups/<name> or ONE_SUBJECT=network has it run for a group or the network. Its first owner is
# the user `owner`, whose device its client is, and `owner`, `alice` and `bob` have their encryption set up on it.
# Another device signs in at its address by the code it shows, which `one sign-in approve` approves as whoever ONE_AS
# names.
#
# Its edge runs here too (`core/edge/`), as every network has one: its Workers in `wrangler dev`, bundled as they're
# deployed (`bun edge.js dev`), with a bucket in
# the machine's S3 store, which every network here shares, in `~/.local/state/one-networks`. Servers keep their blobs through the presigner there, people sign in at its address, and
# whoever holds a sharing link has a way in.
#
# --standby starts a second server, which takes over when the first stops. Each server is called after its folder,
#   `server` and `standby`, as two machines would be called what each is.
# --owner <name> starts a network people sign in to instead: that user is its first owner, it says
#   where they join, with a passkey, and nobody acts as anyone by saying so.
# --live-edge runs the edge's Workers from their source, which `wrangler dev` builds again as each is saved, to work on
#   the edge (`core/edge/`, an app's `edge/`) without starting again.
#
# Where there's no desktop, as under `xvfb-run`, start the app inside `dbus-run-session`: GTK otherwise waits half a
# minute for a desktop that isn't there.
set -euo pipefail
set -m # What's started is a job with a process group of its own, so all of it is stopped at once.

root=$(cd "$(dirname "$0")/.." && pwd)
# Where systemd runs the user's processes, as on a Linux machine many agents share, an agent's own are in a slice
# weighted far below the renderer's runs, so a network started there, which answers within deadlines as any server does
# (a database reads its log from the bucket through the edge in 2 s, or is refused: "Sign-In couldn't be reached just
# now"), got too little of the CPU to meet them. It runs in a slice of its own, beside theirs, as the machine's servers do.
if command -v systemd-run >/dev/null && ! grep -q /networks.slice/ /proc/self/cgroup; then
  exec systemd-run --user --scope --quiet --slice=networks.slice -- "$0" "$@"
fi
# The tools this needs are the ones `mise.toml` names.
command -v mix >/dev/null || exec mise exec -C "$root" -- "$0" "$@"

usage="tooling/network <folder> [--standby] [--owner <name>] [--live-edge]"
folder= standby= owner= live=()
while (($#)); do
  case $1 in
    --standby) standby=yes ;;
    --owner) owner=${2-} && shift ;;
    --live-edge) live=(--live) ;;
    -*) echo "$usage" >&2 && exit 1 ;;
    *) folder=$1 ;;
  esac
  shift
done
# People sign in at an address, and a standby is let in by a client, which there is someone's signed-in device.
[[ -n $folder && (-z $owner || -z $standby) ]] || { echo "$usage" >&2 && exit 1; }
if [[ -n $owner ]]; then as=(--owner "$owner"); else as=(--development --owner owner); fi
mkdir -p "$folder"
folder=$(cd "$folder" && pwd)
# As `pg_ctl` does, the folder holds the PID of what's running in it, whatever started it (`setsid` forks, for one).
if [[ -s $folder/pid ]] && kill -0 "$(cat "$folder/pid")" 2>/dev/null; then
  echo "A network is already running in $folder: kill $(cat "$folder/pid") stops it." >&2 && exit 1
fi
echo $$ >"$folder/pid"
started=()
trap 'for job in "${started[@]}"; do kill -- "-$job" 2>/dev/null || true; done; wait; rm -f "$folder/pid"' EXIT
trap exit TERM INT HUP
one=$root/target/debug/one
# Its Erlang nodes' schedulers sleep when they've nothing to do, as RabbitMQ advises where a machine runs more than
# one thing: by default each spins a while first, which on a machine many networks share takes CPU the others need.
export ERL_FLAGS="+sbwt none +sbwtdcpu none +sbwtdio none ${ERL_FLAGS-}"

[[ -e $root/target ]] || "$root/tooling/copy-build"
(cd "$root/core/codemode" && bun install --frozen-lockfile && bun run build)
# The UI library's packages, which its code reloader builds it with (`bun build.js`).
(cd "$root/core/ui" && bun install --frozen-lockfile)
# Each server compiles what changed as it starts (`mix network`), the Rust workspace too: `one`, and the NIFs
# (`core/server/mix.exs`).
(cd "$root/core/server" && mix deps.get)

# Waits for a line in a log that the job just started is still writing. Fails if the job ends without it.
# GNU's tail follows a file for as long as a process runs, which on a Mac is Homebrew's coreutils' `gtail`.
tail=$(command -v gtail || command -v tail)
wait_for() { grep -q -m1 -E "$1" <("$tail" -F --pid="${started[-1]}" -n +1 "$2"); }
free_port() { bun -e 'const server = Bun.serve({ port: 0, fetch: () => new Response() }); console.log(server.port); server.stop()'; }
random() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }

(cd "$root/core/edge" && bun install --frozen-lockfile)
# Each app's edge function's packages too, in its own folder, which `bun edge.js dev` copies with them: the ones
# `tooling/copy-build` copied from a worktree beside this one may be another commit's.
for edge in "$root"/apps/*/edge/; do (cd "$edge" && bun install --frozen-lockfile); done
# Waits until `$2` answers, however long the process `$1` that serves it takes to start on a busy machine, and stops
# if that process exits first, saying where its log `$3` is.
answers() {
  until curl -s -o /dev/null "$2"; do
    kill -0 "$1" 2>/dev/null || { echo "It stopped as it started: $3 says why" >&2 && exit 1; }
    sleep 1
  done
}
# The network's bucket is one of the machine's bucket store: an S3 store (rustfs) that every network started here
# keeps its bucket in, as an R2 account holds many, started by the first network that needs it and stopped once the
# last of them has, with its data in a folder of its own. A network's bucket is named in its folder's `edge.env`, made
# up once, so a new network in a folder used before has a new one; and one whose folder has gone, or names another, is
# removed. Its edge alone is given the store's keys, with the secret a network's first server shows. They're kept with
# its port, so started again it's at the same address, which a server installed with `one serve on` still reaches.
[[ ! -d $folder/bucket ]] || { echo "$folder keeps its bucket in the folder, as a network did before it was one of the machine's bucket store's: start it in a new folder." >&2 && exit 1; }
[[ -s $folder/edge.env ]] || (umask 077 && echo "name=network-$(random 8) first=$(random 16) gateway=$(free_port)" >"$folder/edge.env")
source "$folder/edge.env"
store=${XDG_STATE_HOME:-$HOME/.local/state}/one-networks
mkdir -p "$store/networks" "$store/bucket"
# Each of a network's processes holds this lock, shared, from its start, so the store is stopped once none of any
# network's is left: what started it waits to hold the lock alone.
exec {using}>>"$store/using"
flock -s "$using"
{
  flock -x 9
  for named in "$store"/networks/*; do
    [[ -L $named ]] || continue
    [[ $(grep -so "name=[^ ]*" "$(readlink "$named")/edge.env") == "name=${named##*/}" ]] && continue
    rm -rf "$store/bucket/${named##*/}" "$store/bucket/.rustfs.sys/buckets/${named##*/}" "$named"
  done
  ln -sfn "$folder" "$store/networks/$name"
  [[ -s $store/keys ]] || (umask 077 && echo "access=$(random 8) secret=$(random 24)" >"$store/keys")
  source "$store/keys"
  if ! { [[ -s $store/address ]] && curl -s -o /dev/null "http://$(cat "$store/address")/"; }; then
    echo "127.0.0.1:$(free_port)" >"$store/address" && rm -f "$store/pid"
    # A bucket on one folder has nothing to heal from, and nothing here asks what it holds, so its scanner and
    # healing don't run: they read the folder over and over even when nothing is asked of it, and on a busy machine
    # their listings time out and start again.
    RUSTFS_ENABLE_SCANNER=false RUSTFS_ENABLE_HEAL=false RUSTFS_ACCESS_KEY=$access RUSTFS_SECRET_KEY=$secret setsid sh -c \
      '"$@" & echo $! >"$0/pid"; flock -x "$0/using" kill $!; wait' "$store" rustfs server --address "$(cat "$store/address")" \
      "$store/bucket" </dev/null >"$store/bucket.log" 2>&1 {using}>&- 9>&- &
    until [[ -s $store/pid ]]; do sleep 0.1; done
    answers "$(cat "$store/pid")" "http://$(cat "$store/address")/" "$store/bucket.log"
  fi
} 9>"$store/lock"
bucket=$(cat "$store/address")
(cd "$root/core/edge" && ACCESS=$access SECRET=$secret BUCKET=http://$bucket/$name bun -e '
  import { AwsClient } from "aws4fetch";
  const { ACCESS: accessKeyId, SECRET: secretAccessKey, BUCKET } = process.env;
  const response = await new AwsClient({ accessKeyId, secretAccessKey, service: "s3", region: "auto" }).fetch(BUCKET, { method: "PUT" });
  if (!response.ok && response.status !== 409) throw new Error(`the bucket answered ${response.status}`);')
# `wrangler dev` gives the presigner its secrets from the environment.
(cd "$root/core/edge" && BUCKET=http://$bucket/$name ACCESS_KEY_ID=$access SECRET_ACCESS_KEY=$secret FIRST_SERVER=$first \
  WRANGLER_SEND_METRICS=false exec bun edge.js dev "${live[@]}" --port "$gateway" \
  --inspector-port "$(free_port)" --persist-to "$folder/edge") >"$folder/edge.log" 2>&1 &
started+=($!)
answers "$!" "http://localhost:$gateway/ping" "$folder/edge.log"
# A passkey is for a name, which on one machine is `localhost`.
at_address=(--address "http://localhost:$gateway" --first "$first")

# Each server is an Erlang node named after its folder and this network's, with a cookie only this network's folder
# holds, so `iex --remsh` attaches to it. An installed server is no node at all (`core/server/rel/env.sh.eex`).
[[ -s $folder/cookie ]] || (umask 077 && random 20 >"$folder/cookie")
node_name() { echo "$1-$(printf %s "$folder" | cksum | cut -d' ' -f1)"; }

# Each server asks the code reloader before it answers a client's request, and it loads what changed in this
# checkout into every server, as Phoenix's does in development (`tooling/code_reloader.exs`). It compiles first.
(cd "$root/core/server" && exec elixir --sname "$(node_name reloader)" --cookie "$(cat "$folder/cookie")" -S \
  mix run --no-start --no-halt ../../tooling/code_reloader.exs "$folder") >"$folder/reloader.log" 2>&1 &
started+=($!)
wait_for "The code reloader is running" "$folder/reloader.log" || { cat "$folder/reloader.log" >&2 && exit 1; }

# Starts a server, and returns once it's running. One that isn't one of the network's yet says how to let it in,
# which is then done as it says, and it's started again.
start() {
  (cd "$root/core/server" && ONE_PROGRAM=$one exec elixir --sname "$(node_name "$1")" --cookie "$(cat "$folder/cookie")" -S \
    mix network "$folder" "$1" --name "$1" --reloader "$(node_name reloader)" "${as[@]}" "${at_address[@]}") \
    >"$folder/$1.log" 2>&1 &
  started+=($!)
  # Its node's program, which a fault is made in (the skill local-network's Faults).
  echo $! >"$folder/$1.pid"
  if ! wait_for "A server is running" "$folder/$1.log"; then
    approve=$(grep -o 'add_server --key [0-9a-f]*' "$folder/$1.log") || { cat "$folder/$1.log" >&2 && exit 1; }
    ONE_AS=owner ONE_SUBJECT=network ONE_HOME=$folder/client "$one" $approve
    start "$1"
  fi
}
start server

# Its client is its first owner's device, signed in at its address by a code as any device is, so it's someone's
# however it reaches the network: `ONE_AS` says who it acts as to a server alone, and a device whose servers don't
# answer asks the address for its token. It's approved from a client that asks the server alone, which needs none.
if [[ -z $owner && $(jq -r .who "$folder/client/network") == null ]]; then
  jq '{address}' "$folder/client/network" >"$folder/client/network.new" && mv "$folder/client/network.new" "$folder/client/network"
  ONE_HOME=$folder/client "$one" sign-in devices >"$folder/client.log" 2>&1 &
  signing=$!
  code='[0-9A-Z]{4}-[0-9A-Z]{4}'
  if grep -q -m1 -E "$code" <("$tail" -F --pid=$signing -n +1 "$folder/client.log"); then
    ONE_AS=owner ONE_HOME=$folder/only-server "$one" sign-in approve --code "$(grep -o -m1 -E "$code" "$folder/client.log")" >/dev/null
    # It's told it's approved, as a push tells a phone, and asks at once, where it asks every 5 s otherwise.
    kill -USR1 $signing
  fi
  wait $signing || { cat "$folder/client.log" >&2 && exit 1; }
fi
[[ -z $standby ]] || start standby

# In a network being built, its people's encryption is set up as each one's first device sets it up: their key is
# made on the client's device, which holds it from then on, as the app run from that home does, and their Vault is
# opened by every server, as their passkey would hand it over (`tooling/keys.ts`), once a server has listed it by
# being asked for it. So the Vault and what's kept encrypted open at once, with no setup screen. A user not set up
# here is set up as a person is, with Unlock with Passkey.
ready() {
  export ONE_AS=$1 ONE_HOME=$folder/client
  [[ $("$one" encryption key | jq -r .check) == null ]] || return 0
  ONE_PROGRAM=$one bun "$root/tooling/keys.ts" make >/dev/null
  "$one" vault list >/dev/null 2>&1 || true
  ONE_PROGRAM=$one bun "$root/tooling/keys.ts" servers >/dev/null
}
if [[ -z $owner ]]; then
  users=(owner alice bob)
  for user in "${users[@]}"; do ready "$user" & readying+=($!); done
  for job in "${readying[@]}"; do wait "$job"; done
  # A browser signed in as its first owner, with no passkey (`one sign-in browser`): Playwright's storage state, which a
  # test browser loads to open the network's address signed in.
  [[ -s $folder/browser.json ]] || ONE_AS=owner ONE_HOME=$folder/client "$one" sign-in browser >"$folder/browser.json"
fi

# The program as whoever started this would type it.
one=${one#"$PWD/"}
[[ -z $owner ]] || cat <<SAID

A network is running in $folder, at ${at_address[1]}.
$(grep -o -m1 "users/$owner joins at.*" "$folder/server.log")

Its client's home is $folder/client, which is nobody's device until they sign in on it:

    export ONE_HOME=$folder/client
    $one                                             opens the app, which signs in
    $one sign-in devices                             shows the code and link that let this device in

What each part says is in $folder/*.log. kill \$(cat $folder/pid) stops it.
SAID
[[ -n $owner ]] || cat <<SAID

A network is running in $folder. Its client's home is $folder/client:

    export ONE_HOME=$folder/client ONE_AS=owner
    $one                                             opens the app, as the network's first owner
    $one permissions group --name family               calls a tool
    ONE_AS=alice $one permissions group --name work    calls one as another user
    $one --help                                      lists every tool
    $one mcp                                         is the same tools as MCP over stdio

${users[*]} have their encryption set up, with their keys on this client's device.
$folder/browser.json signs a browser in as owner at ${at_address[1]} (Playwright's storageState).

    iex --sname dbg-\$\$ --cookie \$(cat $folder/cookie) --remsh $(node_name server)
                                                     attaches to the server, with :recon and :observer_cli
Its address is ${at_address[1]}.

What each part says is in $folder/*.log. kill \$(cat $folder/pid) stops it.
SAID
wait
